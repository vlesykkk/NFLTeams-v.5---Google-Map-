<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <!--
        Logo set directly here (app:srcCompat), not from code, per the
        assignment's instructions. Swap @drawable/colts for whatever
        file name the logo actually has in logos.zip once it's added.
    -->
    <ImageView
        android:id="@+id/team_logo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:contentDescription="@string/team_logo_description"
        app:srcCompat="@drawable/colts"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/team_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/team_logo"
        app:layout_constraintStart_toEndOf="@id/team_logo"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Indianapolis Colts" />

    <TextView
        android:id="@+id/team_division"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="16sp"
        android:textColor="@android:color/darker_gray"
        app:layout_constraintTop_toBottomOf="@id/team_name"
        app:layout_constraintStart_toStartOf="@id/team_name"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="AFC South" />

    <TextView
        android:id="@+id/stadium_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/team_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Lucas Oil Stadium" />

    <!--
        stadium_map (MapView) is intentionally left out of v.1 per the
        assignment instructions. It will be added in a later version.
    -->

</androidx.constraintlayout.widget.ConstraintLayout>
